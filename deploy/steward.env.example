# /etc/steward/steward.env -- systemd EnvironmentFile for steward.service (mode 0600, root-owned).
# The real file is generated on the instance by deploy/user-data.sh. Placeholders only here.

STEWARD_STORE_PATH=/var/lib/steward/steward.sqlite3
STEWARD_IMAGE_ROOT=/var/lib/steward/images
STEWARD_FIXTURE_ROOT=/opt/steward/app/data
STEWARD_FRONTEND_DIST=/opt/steward/app/frontend/dist

# Hosted mode: the public HTTPS origin (CloudFront default hostname). Allowed hosts derive from it.
STEWARD_ORIGIN=https://<distribution-id>.cloudfront.net
STEWARD_LOCAL_HTTP=false
STEWARD_RUNTIME_ENABLED=true

# Two independent secrets.token_hex(32) values generated on the instance; never committed.
STEWARD_SESSION_SECRET=<generated-on-instance>
STEWARD_SERVICE_TOKEN=<generated-on-instance>

# Bedrock, exactly as docs/MODEL_SELECTION.md and src/agent/config.py expect (no role overrides).
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AGENT_TEMPERATURE=0.3
LOG_LEVEL=INFO
