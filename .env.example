# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# --- AWS ---
# Preferred: run `aws configure --profile agents-for-humans` and set the profile here
# instead of pasting keys into this file.
AWS_PROFILE=agents-for-humans
AWS_REGION=us-west-2

# Alternative to a profile (leave blank if using AWS_PROFILE):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Model ---
# Strands' default. Requires Bedrock model access enabled in your account.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Optional role overrides. Leave blank to use BEDROCK_MODEL_ID.
BEDROCK_TEXT_MODEL_ID=
BEDROCK_VISION_MODEL_ID=
AGENT_TEMPERATURE=0.3

LOG_LEVEL=INFO

# --- Steward web sandbox (separate from CLI/model settings) ---
# Read docs/API.md. Create the private directory explicitly before starting the API.
STEWARD_STORE_PATH=.steward/steward.sqlite3
STEWARD_ORIGIN=http://localhost:8000
STEWARD_LOCAL_HTTP=true
# Generate TWO independent secrets once with secrets.token_hex(32). Persist privately.
# Blank/malformed/placeholder/equal secrets fail API startup; no auto-generation.
STEWARD_SESSION_SECRET=
STEWARD_SERVICE_TOKEN=
# Optional explicit loopback UI origin when a development proxy preserves that Origin.
# This does not enable CORS. Prefer a same-origin /api proxy.
STEWARD_DEVELOPMENT_ORIGINS=
# Explicitly enable persisted pending-work discovery and the real HTTP-only agent runner.
# Leave false for component development. Enabling can invoke the configured Bedrock models.
STEWARD_RUNTIME_ENABLED=false

# Built SPA location; empty disables static serving (API-only hosts).
STEWARD_FRONTEND_DIST=frontend/dist
